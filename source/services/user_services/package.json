{
  "name": "user-management-service",
  "version": "1.0.0",
  "description": "User management service with MongoDB and Redis",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "proto:generate": "npx grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=node_modules\\.bin\\protoc-gen-ts_proto.cmd   --ts_proto_out=.\\src\\proto\\generated --proto_path=.\\src\\proto .\\src\\proto\\*.proto",
    "test": "ts-node src/test/client.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.4.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "grpc-web": "^1.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "redis": "^4.6.12",
    "ts-protoc-gen": "^0.15.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/google-protobuf": "^3.15.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.1",
    "@types/uuid": "^9.0.7",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.7.5",
    "typescript": "^5.8.3"
  }
}