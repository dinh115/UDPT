# .env for analysis_services
# MySQL Database
MYSQL_HOST=mysql-analysis
MYSQL_PORT=3310
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_DATABASE=appointment_db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq-analysis
EXCHANGE_NAME=streaming_exchange

# Queues and Routing Keys
QUEUE_APPOINTMENT=appointment_queue
ROUTING_KEY_APPOINTMENT=appointment
QUEUE_PRESCRIPTION=prescription_queue
ROUTING_KEY_PRESCRIPTION=prescription
QUEUE_PRESCRIPTION_UPDATE=prescription_updated_queue
ROUTING_KEY_PRESCRIPTION_UPDATE=prescription_update
QUEUE_APPOINTMENT_UPDATE=appointment_update_queue
ROUTING_KEY_APPOINTMENT_UPDATE=appointment_update

# gRPC Server
GRPC_HOST=0.0.0.0
GRPC_PORT=3005